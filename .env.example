# ==============================================================================
# Candidate Sourcing System - Environment Configuration
# ==============================================================================

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/candidate_sourcing

# Security / Auth
SECRET_KEY=change_this_to_a_very_secure_random_secret_key_in_production
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# File Storage
UPLOAD_DIR=./data/uploads

# Mailer / SMTP (Mailhog default for local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@talentbridge.local

# Bootstrap Admin Credentials
ADMIN_EMAIL=admin@talentbridge.local
ADMIN_PASSWORD=Admin@12345

# URL Configuration
PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=
